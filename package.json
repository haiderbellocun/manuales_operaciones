{
  "name": "acervo-operaciones",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma institucional de gestión documental — Área de Operaciones",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently -n web,api -c green,blue \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "server:start": "npm run start --prefix server",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "mammoth": "^1.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "vite": "^6.0.3"
  }
}
