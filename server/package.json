{
  "name": "acervo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST — Acervo Operaciones",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node -e \"import('./src/db/migrate.js').then(m=>m.migrate()).then(()=>{console.log('OK');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
