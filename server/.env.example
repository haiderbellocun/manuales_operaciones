PORT=3000
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga
CORS_ORIGIN=http://localhost:5173

# Desarrollo local con PostgreSQL instalado en tu equipo.
DATABASE_URL=postgresql://postgres:root@localhost:5432/manuales-operaciones

# Obligatorio para subir y consultar documentos, incluso corriendo local.
GCS_BUCKET=tu-bucket-documentos

# Correo SMTP para notificaciones.
# Si falta alguno, la notificacion interna se crea y el email queda failed con el error.
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=password-smtp
SMTP_FROM="Acervo Operaciones <no-reply@tu-dominio.com>"

# Desarrollo local con cuenta de servicio.
# Recomendado: guarda el JSON fuera del repo o en ./secrets, que esta ignorado por Git.
# En Windows puedes usar ruta absoluta:
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\tu_usuario\Documents\gcp\acervo-storage-sa.json
# O ruta relativa desde la raiz del proyecto:
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/acervo-storage-sa.json

# Produccion en GCP.
# PORT=8080
# NODE_ENV=production
# GCS_BUCKET=tu-bucket-documentos
# CLOUD_SQL_CONNECTION_NAME=tu-proyecto:us-central1:tu-instancia
# DB_USER=postgres
# DB_PASSWORD=tu-password
# DB_NAME=manuales-operaciones
